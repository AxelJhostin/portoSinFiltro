PORT=4000

# Conseguir en: Supabase > Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase > Project Settings > API Keys > secret
SUPABASE_SERVICE_KEY=tu-secret-key   # ⚠️ NUNCA exponer al frontend

# URL(s) del frontend permitidas por CORS — separadas por coma si son varias
# (ej. dominio de producción en Vercel + localhost en desarrollo).
FRONTEND_URL=http://localhost:5173,https://portosinfiltro.vercel.app

# Activar solo después de desplegar notify-status y configurar RESEND_API_KEY y EMAIL_FROM.
NOTIFICATIONS_ENABLED=false

# NOTA: la verificación de tokens usa el JWKS de Supabase (ES256),
# por lo que NO se necesita SUPABASE_JWT_SECRET.
